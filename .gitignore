# OS / editor junk
.DS_Store
Thumbs.db
*.log

# Internal briefing PDFs: kept local, not published
uploads/

# Prototype host preview artifact
.thumbnail

# Internal roadmap/specs (local only, importados no Notion)
docs/specs/

# Workflows n8n (locais, nao publicar)
n8n/

