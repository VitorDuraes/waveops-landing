{
  "name": "waveops-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync:landing": "node scripts/sync-landing.mjs",
    "predev": "node scripts/sync-landing.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/sync-landing.mjs",
    "build": "next build",
    "vercel-build": "prisma generate && npm run build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:unit": "tsx --test tests/unit/*.test.ts tests/integration/site-portal-checks.test.mjs",
    "test:integration:leads": "node --conditions=react-server --import tsx --test tests/integration/leads-excecoes.test.ts",
    "test:integration:site": "node --test --test-concurrency=1 tests/integration/site-portal-checks.test.mjs tests/integration/site-portal.test.mjs",
    "check:email": "node scripts/verificar-email.mjs",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "set-password": "tsx scripts/set-password.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-logs": "^0.223.0",
    "@prisma/client": "^6.19.3",
    "@vercel/otel": "^2.1.3",
    "clsx": "^2.1.1",
    "framer-motion": "^14.0.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.52.0",
    "next": "^16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "parse5": "8.0.1",
    "postcss": "^8.5.29",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
